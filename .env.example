# ---------------------------------------------------------------------------
# Lead Generator Website — environment variables
# The Generator Core runs with NO env vars. These are for later phases.
# Copy to `.env.local` and fill in as you enable features.
# ---------------------------------------------------------------------------

# Public site URL — the SINGLE source of truth for every canonical URL, OG tag,
# sitemap entry, robots host, and JSON-LD @id (see lib/site.ts). Set this to your
# public https origin before deploying, or a production build warns that it is
# still localhost (it does not fail — the offline demo builds with zero env vars).
# Silence the warning for an intentional demo/CI build with ALLOW_LOCALHOST_BUILD.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Acknowledge a non-production build that intentionally ships a localhost origin
# (demo/CI). Set to "1" to silence the localhost warning above.
# ALLOW_LOCALHOST_BUILD="1"

# --- API security & rate limiting (lib/api/security.ts, lib/api/rate-limit.ts) ---
# Admin token gating the AI management API (/api/ai/generate|regenerate|batch|
# cache|prompts|status|provider). These endpoints FAIL CLOSED: with no token set
# they return 503 (disabled), so set this to enable them in production.
# ADMIN_API_TOKEN=""
#
# Per-instance sliding-window rate limits (requests / window-ms). All optional —
# these are the built-in defaults. Note: counters are per server instance; use a
# shared store (Redis/Upstash) behind multiple instances. See SECURITY.md.
# RATE_LIMIT_LEAD="5"
# RATE_LIMIT_LEAD_WINDOW_MS="60000"
# RATE_LIMIT_GENERATE="10"
# RATE_LIMIT_GENERATE_WINDOW_MS="60000"
# RATE_LIMIT_AI_READ="60"
# RATE_LIMIT_AI_READ_WINDOW_MS="60000"
# RATE_LIMIT_AI_WRITE="10"
# RATE_LIMIT_AI_WRITE_WINDOW_MS="60000"

# --- Phase 3: AI Content Engine ---
# Provider is chosen here; with NO key set the engine runs the deterministic
# fallback (fully offline). Set AI_PROVIDER + the matching key to enable live AI.
# AI_PROVIDER="openai"          # openai | anthropic | gemini | openrouter | mock
# AI_MODEL=""                   # optional model override (else provider default)
# AI_TEMPERATURE="0.7"
# AI_MAX_TOKENS="2000"
# AI_CONCURRENCY="4"            # max concurrent provider calls
# AI_MIN_INTERVAL_MS="0"        # min spacing between provider calls (rate limit)
#
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GEMINI_API_KEY=""             # or GOOGLE_API_KEY
# OPENROUTER_API_KEY=""

# --- Phase 7.1: Authentication (Auth.js v5) ---
# Auth.js v5 reads AUTH_SECRET (NEXTAUTH_SECRET is still honored as a fallback).
# Generate one with:  npx auth secret   (or: openssl rand -base64 32)
# Required once auth routes are used; unused for the offline generation demo.
# AUTH_SECRET=""
# AUTH_URL="http://localhost:3000"          # optional; inferred from request in most setups
#
# Trust the proxy Host header when resolving auth callback URLs. Auth.js trusts the
# host automatically in development and on Vercel; behind any OTHER reverse proxy
# (Docker, Nginx, Fly, Render, self-hosted) you MUST set this to "true" in production
# or sign-in fails with `UntrustedHost`. Only enable it when your proxy sets a
# correct, non-spoofable Host / X-Forwarded-Host header.
# AUTH_TRUST_HOST="true"
#
# OAuth providers are OPTIONAL and enabled only when BOTH id+secret are present
# (offline-safe: with no keys set, only Credentials sign-in is active).
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
#
# Transactional email seam (verification + password-reset links). With no provider
# configured the link is logged to the server console in development (lib/auth/email.ts).
# EMAIL_FROM="no-reply@example.com"
# Token lifetimes (hours) — optional overrides.
# AUTH_EMAIL_VERIFICATION_TTL_HOURS="24"
# AUTH_PASSWORD_RESET_TTL_HOURS="1"

# --- Phase 7.1: Database (PostgreSQL via Prisma) ---
# Local development: Docker Postgres (docker-compose.yml → `npm run db:up`).
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leadgen?schema=public"
#   DIRECT_URL="postgresql://postgres:postgres@localhost:5432/leadgen?schema=public"
#
# Production: Neon. Use the POOLED connection for DATABASE_URL (…-pooler.neon.tech,
# with ?sslmode=require) and the DIRECT connection for DIRECT_URL (used by migrations).
#   DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require"
#   DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DB?sslmode=require"
# DATABASE_URL=""
# DIRECT_URL=""

# --- Phase 9: Uploads (UploadThing) ---
# UPLOADTHING_TOKEN=""
