# ---------------------------------------------------------------------------
# Lead Generator Website — environment variables
# The Generator Core runs with NO env vars. These are for later phases.
# Copy to `.env.local` and fill in as you enable features.
# ---------------------------------------------------------------------------

# Public site URL — the SINGLE source of truth for every canonical URL, OG tag,
# sitemap entry, robots host, and JSON-LD @id (see lib/site.ts). Set this to your
# public https origin before deploying, or a production build warns that it is
# still localhost (it does not fail — the offline demo builds with zero env vars).
# Silence the warning for an intentional demo/CI build with ALLOW_LOCALHOST_BUILD.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Acknowledge a non-production build that intentionally ships a localhost origin
# (demo/CI). Set to "1" to silence the localhost warning above.
# ALLOW_LOCALHOST_BUILD="1"

# --- API security & rate limiting (lib/api/security.ts, lib/api/rate-limit.ts) ---
# Admin token gating the AI management API (/api/ai/generate|regenerate|batch|
# cache|prompts|status|provider). These endpoints FAIL CLOSED: with no token set
# they return 503 (disabled), so set this to enable them in production.
# ADMIN_API_TOKEN=""
#
# Per-instance sliding-window rate limits (requests / window-ms). All optional —
# these are the built-in defaults. Note: counters are per server instance; use a
# shared store (Redis/Upstash) behind multiple instances. See SECURITY.md.
# RATE_LIMIT_LEAD="5"
# RATE_LIMIT_LEAD_WINDOW_MS="60000"
# RATE_LIMIT_GENERATE="10"
# RATE_LIMIT_GENERATE_WINDOW_MS="60000"
# RATE_LIMIT_AI_READ="60"
# RATE_LIMIT_AI_READ_WINDOW_MS="60000"
# RATE_LIMIT_AI_WRITE="10"
# RATE_LIMIT_AI_WRITE_WINDOW_MS="60000"

# --- Phase 3: AI Content Engine ---
# Provider is chosen here; with NO key set the engine runs the deterministic
# fallback (fully offline). Set AI_PROVIDER + the matching key to enable live AI.
# AI_PROVIDER="openai"          # openai | anthropic | gemini | openrouter | mock
# AI_MODEL=""                   # optional model override (else provider default)
# AI_TEMPERATURE="0.7"
# AI_MAX_TOKENS="2000"
# AI_CONCURRENCY="4"            # max concurrent provider calls
# AI_MIN_INTERVAL_MS="0"        # min spacing between provider calls (rate limit)
#
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
# GEMINI_API_KEY=""             # or GOOGLE_API_KEY
# OPENROUTER_API_KEY=""

# --- Phase 1: Auth (NextAuth) ---
# NEXTAUTH_SECRET=""
# NEXTAUTH_URL="http://localhost:3000"

# --- Phase 1/13: Database (Supabase / PostgreSQL via Prisma) ---
# DATABASE_URL=""
# DIRECT_URL=""

# --- Phase 9: Uploads (UploadThing) ---
# UPLOADTHING_TOKEN=""
